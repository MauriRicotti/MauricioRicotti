{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:preview": "SINGLEFILE=1 vite build && node scripts/build-preview.mjs && vite build --logLevel warn",
    "live": "vite build && (vite build --watch --logLevel warn & vite preview --port 5173 --strictPort)",
    "cv": "node scripts/build-cv.mjs",
    "check": "tsc --noEmit && node scripts/check-sound.mjs && vite build && node scripts/check-seo.mjs && node scripts/check-404.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "clsx": "2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "motion": "^14.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "3.4.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
